    "m_FunctionBody": "const float TAU = 6.28318530718;\r\nconst int MAX_ITER = 8;\r\r\n    float2 p = fmod(uv * TAU, TAU) - 250.0;\r\n    float3 c = float3(1.0, 1.0, 1.0);  // 改为float3存储RGB值\r\n    float inten = 0.005;\r\n    float phase_shift_amount = 0.08;  // 新增相位偏移量\r\n    \r\n    float2 i_r = p;  // 新增红色通道迭代变量\r\n    float2 i_g = p;  // 新增绿色通道迭代变量\r\n    float2 i_b = p;  // 新增蓝色通道迭代变量\r\n\r\n    for (int n = 0; n < MAX_ITER; n++) {\r\n        float t = time * (1.0 - (3.5 / (n + 1)));\r\n        \r\n        // 分别计算三个通道的偏移\r\n        i_g = p + float2(cos(t - i_g.x) + sin(t + i_g.y), sin(t - i_g.y) + cos(t + i_g.x));\r\n        i_r = p + float2(cos(t - i_r.x - phase_shift_amount*0.5) + sin(t + i_r.y - phase_shift_amount*0.5), \r\n                         sin(t - i_r.y - phase_shift_amount*0.5) + cos(t + i_r.x - phase_shift_amount*0.5));\r\n        i_b = p + float2(cos(t - i_b.x + phase_shift_amount*0.5) + sin(t + i_b.y + phase_shift_amount*0.5), \r\n                         sin(t - i_b.y + phase_shift_amount*0.5) + cos(t + i_b.x + phase_shift_amount*0.5));\r\n\r\n        // 分别计算三个通道的值\r\n        c.r += 1.0 / length(float2(p.x / (sin(i_r.x + t - phase_shift_amount)/inten), \r\n                                  p.y / (cos(i_r.y + t - phase_shift_amount)/inten)));\r\n        c.g += 1.0 / length(float2(p.x / (sin(i_g.x + t)/inten), \r\n                                  p.y / (cos(i_g.y + t)/inten)));\r\n        c.b += 1.0 / length(float2(p.x / (sin(i_b.x + t + phase_shift_amount)/inten), \r\n                                  p.y / (cos(i_b.y + t + phase_shift_amount)/inten)));\r\n    }\r\n    \r\n    c /= MAX_ITER;\r\n    c = 1.17 - pow(c, float3(1.4, 1.4, 1.4));  // 改为对float3操作\r\n    float3 colour = pow(abs(c), float3(8.0, 8.0, 8.0));\r\n    colour = saturate(colour);\r\n\r\n    Out = colour;"
}

