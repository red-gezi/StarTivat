{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "ba8235ec0d0d417d86ea7759fd4eda84",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Wave (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1076.6666259765625,
            "y": 4194.6669921875,
            "width": 209.33331298828126,
            "height": 328.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "6761316984834cb19113afa556e7bcb9"
        },
        {
            "m_Id": "0825b07108894f2ca1cfd96b33ddc04c"
        },
        {
            "m_Id": "63b8191c0f1b4cb1874cea4dc954b10c"
        },
        {
            "m_Id": "bc3946c1f83a47cabf1cffc7453d25e1"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Wave",
    "m_FunctionSource": "",
    "m_FunctionBody": "const float TAU = 6.28318530718;\r\nconst int MAX_ITER = 8;\r\n    float2 p = fmod(uv * TAU, TAU) - 250.0;\r\n    float c = 1.0;\r\n    float inten = 0.005;\r\n    float2 i = p;\r\n\r\n    for (int n = 0; n < MAX_ITER; n++) {\r\n        float t = time * (1.0 - (3.5 / (n + 1)));\r\n        i = p + float2(cos(t - i.x) + sin(t + i.y), sin(t - i.y) + cos(t + i.x));\r\n        c += 1.0 / length(float2(p.x / (sin(i.x + t)/inten), p.y / (cos(i.y + t)/inten)));\r\n    }\r\n    c /= MAX_ITER;\r\n    c = 1.17 - pow(c, 1.4);\r\n    float3 colour = pow(abs(c), 8.0);\r\n    colour = saturate(colour + float3(0.0, 0.0, 0.0));\r\n\r\n    Out = colour;"
}

