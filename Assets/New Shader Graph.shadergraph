    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Wave",
    "m_FunctionSource": "",
    "m_FunctionBody": "const float TAU = 6.28318530718;\r\nconst int MAX_ITER = 5;\nfloat2 fragCoord = uv * Resolution.xy;\r\n    float2 p = fmod(uv * TAU, TAU) - 250.0;\r\n    float c = 1.0;\r\n    float inten = 0.005;\r\n    float2 i = p;\r\n\r\n    for (int n = 0; n < MAX_ITER; n++) {\r\n        float t = time * (1.0 - (3.5 / (n + 1)));\r\n        i = p + float2(cos(t - i.x) + sin(t + i.y), sin(t - i.y) + cos(t + i.x));\r\n        c += 1.0 / length(float2(p.x / (sin(i.x + t)/inten), p.y / (cos(i.y + t)/inten)));\r\n    }\r\n    c /= MAX_ITER;\r\n    c = 1.17 - pow(c, 1.4);\r\n    float3 colour = pow(abs(c), 8.0);\r\n    colour = saturate(colour + float3(0.0, 0.0, 0.0));\r\n\r\n    Out = colour;"
}

