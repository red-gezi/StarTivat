    "m_ObjectId": "729d3d2b4fc34d13a5dad232f728bf89",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "_ (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 2003.9998779296875,
            "y": 1731.3333740234375,
            "width": 220.0001220703125,
            "height": 328.0001220703125
        }
    },
    "m_Slots": [
        {
            "m_Id": "780773f8bdd2492faec2816ac8c0e7b4"
        },
        {
            "m_Id": "ea2522b2c0424a1693baa0c3bd1a84a6"
        },
        {
            "m_Id": "9cd9d8e5907f45e088184eea76f89f77"
        },
        {
            "m_Id": "3e20792a82fe4c018f3cb74c9561e850"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "_",
    "m_FunctionSource": "",
    "m_FunctionBody": "  float2 centered_uv = (uv * 2.0) - 1.0;\r\n    \r\n    // 计算极坐标参数\r\n    float r = length(centered_uv);\r\n    float theta = atan2(centered_uv.y, centered_uv.x);\r\n    \r\n    // 计算径向偏移量\r\n    float displacement = r * effectStrength * (1.0 - r);\r\n    float r_source = r + displacement;\r\n    \r\n    // 转换回笛卡尔坐标系\r\n    float2 source_centered_uv = float2(cos(theta), sin(theta)) * r_source;\r\n    \r\n    // 重新映射到[0,1]空间\r\n    _Output = (source_centered_uv + 1.0) * 0.5;"
}

