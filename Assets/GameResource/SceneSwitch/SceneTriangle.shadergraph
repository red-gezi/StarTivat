{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "3b0f276c3cf34a0e92e7b395dd91d1b5",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "_ (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 1038.0,
            "y": 2984.66650390625,
            "width": 241.3333740234375,
            "height": 352.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "ad298b451f104231b250222862fe17f7"
        },
        {
            "m_Id": "38f5ef387e8449f7ac66eefdbc9beece"
        },
        {
            "m_Id": "0ebd2da14efa40e38eb3e6b5caa935b2"
        },
        {
            "m_Id": "2c08d352b5184273ba36628c414f70d0"
        },
        {
            "m_Id": "1d6a55da184145c1bdb2555d8ea0b005"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "_",
    "m_FunctionSource": "",
    "m_FunctionBody": "\tfloat2 centered = (uv * 2.0 - 1.0);\r\n    \r\n    // 2. 计算径向和方形距离\r\n    float radialDist = length(centered);\r\n    float squareDist = max(abs(centered.x), abs(centered.y));\r\n    \r\n    // 3. 混合两种距离模式\r\n    float distance = lerp(radialDist, squareDist, edgeSoftness);\r\n    \r\n    // 4. 凹透镜公式 (使用负值产生凹陷效果)\r\n    float z = sqrt(1.0 + distance * distance * effectStrength);\r\n    float r = atan2(distance, z) / 3.14159*x;\r\n    \r\n    // 5. 极坐标转回笛卡尔坐标\r\n    float phi = atan2(centered.y, centered.x);\r\n    float2 cart = float2(\r\n        cos(phi) * r,\r\n        sin(phi) * r\r\n    );\r\n    \r\n    // 6. 转换回[0,1]空间并限制范围\r\n    distortedUV = cart * 0.5 + 0.5;\r\n    distortedUV = clamp(distortedUV, 0.0, 1.0);"
}

